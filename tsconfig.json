{
    "compilerOptions": {
        "target": "es2020",
        "module": "commonjs",
        "outDir": "./build",
        "strict": true,
        "declaration": false,
        "noImplicitAny": true,
        "typeRoots": ["./node_modules/@types"],
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "skipLibCheck": true
    },
    "exclude": ["./build/*", "./node_modules/*"],
    "include": [ "./src/**/*.ts", "./src/**/*.json", "./playground/**/*.ts" ]
}