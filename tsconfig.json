{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "resolveJsonModule": true,
    "typeRoots": ["./node_modules/@types"],
    "strict": true,
    "noImplicitAny": true,
    "declaration": false,
    "outDir": "./build",
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["./src/**/*.ts", "./src/**/*.json", "./playground/**/*.ts"],
  "exclude": ["./build/*", "./node_modules/*"]
}
