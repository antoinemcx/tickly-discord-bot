{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "paths": {
      "@bot/*": ["./src/bot/*"],
      "@services/*": ["./src/services/*"],
      "@database/*": ["./src/database/*"],
      "@src/*": ["./src/*"]
    },
    "resolveJsonModule": true,
    "typeRoots": ["./node_modules/@types"],
    "types": ["jest", "node"],
    "strict": true,
    "noImplicitAny": true,
    "declaration": false,
    "outDir": "./build",
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "./src/**/*.ts",
    "./src/**/*.json",
    "./tests/**/*.ts",
    "./playground/**/*.ts"
  ],
  "exclude": ["./build/*", "./node_modules/*"]
}
