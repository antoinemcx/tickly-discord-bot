{
  "name": "tickly-discord-bot",
  "version": "0.0.0",
  "description": "",
  "author": "antoinemcx",
  "main": "build/src/index.js",
  "scripts": {
    "clean": "rimraf build/* --glob",
    "build": "tsc --build && tsc-alias -p tsconfig.json && copyfiles -u 3 \"src/bot/assets/**/*\" build/src/bot/assets && copyfiles -u 4 \"src/services/oauth/assets/**/*\" build/src/services/oauth/assets",
    "start": "npm run clean && npm run build && node .",
    "start:nobuild": "node .",
    "test": "jest --silent",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:drop": "drizzle-kit drop"
  },
  "dependencies": {
    "@doist/todoist-api-typescript": "^7.7.0",
    "discord.js": "^14.25.1",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "moment": "^2.30.1",
    "mysql2": "^3.10.1",
    "node-cron": "^4.6.0",
    "tsx": "^4.15.7"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.14.6",
    "copyfiles": "^2.4.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.1.0",
    "jest": "^29.7.0",
    "rimraf": "^5.0.7",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "typescript": "^6.0.2"
  }
}
