# Todoist API integration
TODOIST_CLIENT_ID=
TODOIST_CLIENT_SECRET=
OAUTH_SERVICE_PORT=

# Discord bot
DISCORD_CLIENT_TOKEN=

# Database connection
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
# Docker-specific root password
DB_ROOT_PASSWORD=
# False to skip automatic DB migrations at startup
AUTO_MIGRATE=true

# Encryption
# Must be exactly 32 bytes, base64-encoded (44 characters)
TOKEN_ENCRYPTION_KEY=

# Redis cache
# Leave REDIS_HOST empty to disable caching entirely
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=